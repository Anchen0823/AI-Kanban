# 仓库内统一使用 LF，避免 Windows / macOS / Linux 之间因换行符产生无意义的整文件 diff。
* text=auto eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
*.sqlite binary
*.woff binary
*.woff2 binary

# lockfile 与生成物不参与 diff 统计
package-lock.json -diff linguist-generated
packages/core/dist/** -diff linguist-generated
