{
  "name": "@aicc/mcp",
  "version": "0.2.0",
  "private": true,
  "description": "本地 stdio MCP 服务：把工作台的记忆能力以 MCP 工具暴露给 Codex / Cursor 等客户端",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "aicc-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@aicc/core": "0.2.0"
  }
}
