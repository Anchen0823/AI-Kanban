# --- 依赖 ---
node_modules/
.npm/
.pnpm-store/

# --- 构建产物 ---
dist/
build/
*.tsbuildinfo
.vite/

# --- 本地运行数据（真实数据目录，绝不入库） ---
data/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
backups/
exports/
*.env
.env
.env.local
.env.*.local

# --- 探针与临时文件 ---
# 约定：助手排障时产生的临时脚本/输出一律以点开头，一律不入库。
# 这不是洁癖 —— 这类文件里经常带着本机路径、端口号或测试用的令牌，
# 混进仓库后很难被发现。
scripts/.*
.*-test.txt
.*-probe.txt
.probe-*.txt
.env-probe.txt
.core-test.txt
.server-test.txt
.web-test.txt
# 探针产物目录：由 `codex app-server generate-json-schema` 生成，可随时重新导出。
.probe-codex/
.m1.txt
logs/
*.log
tmp/
.tmp/

# --- 助手工作状态（保留在磁盘，但不属于项目源码） ---
.workbuddy/

# --- 编辑器 / 系统 ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- 安全：任何凭据、导出的真实记忆包 ---
*.pem
*.key
credentials.json
